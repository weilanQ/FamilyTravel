# Copy to .env and fill in your own keys. Never commit .env.

# --- Generation LLM (default provider: openrouter, model: openai/gpt-4o-mini) ---
GENERATION_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# OPENROUTER_GENERATION_MODEL=openai/gpt-4o-mini

# --- Judge LLM (default provider: deepseek, model: deepseek-chat) ---
LLM_JUDGE_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_LLM_JUDGE_MODEL=deepseek-chat

# --- Optional: use OpenAI directly instead ---
# OPENAI_API_KEY=

# --- Online grounding search provider (default: tavily; also: google_places / serpapi / bing) ---
# ONLINE_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# GOOGLE_PLACES_API_KEY=   (also used by src/field_authenticity.py verification)
# SERPAPI_API_KEY=
# BING_SEARCH_API_KEY=
